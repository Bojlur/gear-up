  "main": "server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "build:api": "prisma generate && esbuild src/app.ts --bundle --platform=node --format=esm --target=node22 --outfile=api/index.js --packages=external",
