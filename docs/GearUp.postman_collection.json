                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startDate\": \"{{startDate}}\",\n  \"endDate\": \"{{endDate}}\",\n  \"items\": [\n    {\n      \"gearItemId\": \"{{gearItemId}}\",\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const start = new Date(); start.setDate(start.getDate() + 1);",
                  "const end = new Date(); end.setDate(end.getDate() + 4);",
                  "pm.collectionVariables.set('startDate', start.toISOString());",
                  "pm.collectionVariables.set('endDate', end.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const value = json?.['data']?.['id'];",
