                "api",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer1@test.com\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.data) {",
                  "    const token = json.data.accessToken;",
                  "    const user = json.data.user || json.data;",
                  "    if (token) pm.collectionVariables.set('customerToken', token);",
                  "    if (user && user.id) pm.collectionVariables.set('customerId', user.id);",
                  "    console.log('customerToken saved');",
                  "}"
                ]
              }
            }
          ]
        },
